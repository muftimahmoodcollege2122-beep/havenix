# DATABASE_URL=postgresql://user:pass@host:5432/havenix
# PORT=4000

# Admin panel access key — required to log into /admin.
# Set a strong, unique value in Railway's environment variables.
ADMIN_KEY=havenix-admin

# Public URL of the deployed client app — used to build gateway return/webhook URLs.
CLIENT_URL=http://localhost:5173

# ── Payments ──
# "mock" simulates a gateway entirely in-app (no real money, fully testable today).
# Set to "simpaisa" once real credentials + API docs are wired into simpaisaProvider.ts.
PAYMENT_PROVIDER=mock

# Only needed when PAYMENT_PROVIDER=simpaisa:
# SIMPAISA_MERCHANT_ID=
# SIMPAISA_SECRET=
# SIMPAISA_ENV=staging          # staging | live
# SIMPAISA_WEBHOOK_URL=https://your-backend.up.railway.app/api/payments/webhook

# Secret used to sign customer login sessions (JWT). Set a long random value in production.
JWT_SECRET=change-this-to-a-long-random-string
